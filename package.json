{
  "name": "sitenote",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'tests/**/*.test.ts' 'src/**/*.test.ts'",
    "test:integration": "node --test tests/voice-integration.test.mjs",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test 'tests/**/*.test.ts' 'src/**/*.test.ts'",
    "web:build": "vite build web --outDir ../dist/web --emptyOutDir --assetsInlineLimit 0",
    "test:web": "playwright test"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-keep-awake": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
